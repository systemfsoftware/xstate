{
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@effect/tsgo": "catalog:",
    "@systemfsoftware/oxlint-config-recommended": "catalog:",
    "@systemfsoftware/stryker-ignorer-effect-schema-declarations": "catalog:",
    "@systemfsoftware/stryker-js": "catalog:",
    "@systemfsoftware/stryker-js-typescript-checker": "catalog:",
    "@systemfsoftware/stryker-js-vitest-runner": "catalog:",
    "@systemfsoftware/tsconfig": "catalog:",
    "@types/node": "catalog:",
    "vitest": "catalog:",
    "lint-staged": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "license": "Apache-2.0",
  "name": "xstate",
  "packageManager": "pnpm@12.9.0",
  "private": true,
  "scripts": {
    "assert-local-sfs": "awk -f nix/from-source/assert-local-sfs.awk pnpm-lock.yaml nix/*/pnpm-lock.yaml",
    "attw": "sandbox -- turbo --concurrency=${TURBO_CONCURRENCY:-50%} attw",
    "bootstrap": "sandbox -- pnpm install && sandbox -- pnpm rebuild --config.ignore-scripts=false && sandbox -- pnpm run prepare",
    "build": "sandbox -- turbo --concurrency=${TURBO_CONCURRENCY:-50%} build",
    "check:ci": "s=0; pnpm format:check || s=1; TURBO_CONCURRENCY=${TURBO_CONCURRENCY:-100%} pnpm gate:tasks || s=1; pnpm gate:dist || s=1; pnpm test:sandbox || s=1; exit $s",
    "clean": "sandbox -- turbo clean",
    "format": "./bin/dprint fmt",
    "format:check": "./bin/dprint check",
    "gate:dist": "sandbox -- turbo --concurrency=${TURBO_CONCURRENCY:-100%} build attw",
    "gate:tasks": "sandbox --allow-host jsr.io --allow-host registry.npmjs.org -- turbo --concurrency=${TURBO_CONCURRENCY:-50%} --continue lint lint:tsgo typecheck typecheck:node test test:scripts attw",
    "lint": "sandbox -- turbo --concurrency=${TURBO_CONCURRENCY:-50%} lint lint:tsgo",
    "mutation": "sandbox -- turbo --concurrency=${TURBO_CONCURRENCY:-50%} mutation",
    "precommit": "pnpm exec lint-staged --no-revert --config .lintstagedrc.js",
    "prepare": "effect-tsgo patch --oxlint --no-typescript --skip-missing",
    "test": "sandbox --allow-host jsr.io --allow-host registry.npmjs.org -- turbo --concurrency=${TURBO_CONCURRENCY:-50%} test test:scripts && pnpm test:sandbox",
    "test:sandbox": "nix run .#sandbox-proofs && deno test --config=scripts/deno.json --allow-run=git,sandbox,sh --allow-env --allow-read --allow-write sandbox-proofs/",
    "typecheck": "sandbox -- turbo --concurrency=${TURBO_CONCURRENCY:-50%} --continue typecheck typecheck:node",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "test:scripts": "deno test --config=scripts/deno.json --allow-read --allow-write --allow-run=awk,git --allow-import=jsr.io --allow-env scripts/"
  },
  "type": "module"
}
